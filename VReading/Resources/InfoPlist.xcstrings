  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Transfer runs a server on your local network so you can upload books and dictionaries from a computer browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WiFi传书需要在局域网内启动服务, 以便电脑浏览器上传图书、字典文件。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe podcast audio on your device to generate synced subtitles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在本机识别播客音频, 生成同步字幕。"
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VReading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VReading"
          }
        }
      }
    }
  }
